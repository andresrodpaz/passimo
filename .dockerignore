# Keep the build context small and free of anything that must never reach an
# image layer. Everything here is either regenerated by the build, local-only, or
# a secret.

node_modules
.next
.git
.github

# Secrets and local configuration. Production values come from Railway's
# variable editor, never from a file baked into the image.
.env
.env.*
!.env.example

# Local artefacts
*.log
tsconfig.tsbuildinfo
coverage
test-results
playwright-report
.uploads
.uploads-test
.claude

# Documentation and planning material: large, and not needed at runtime.
docs
prompt*.md
master.md
*_REPORT.md
PROJECT_STATUS.md
PASSIMO_LAUNCH_STATUS.md
