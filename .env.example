# =============================================================================
# Passimo configuration
#
# Only the "Required" block is needed to boot. Every other section unlocks a
# capability; when its variables are absent the feature is reported as
# "not configured" in Settings rather than failing at runtime. That is a
# deliberate property — a merchant self-hosting with nothing but a database gets
# a working loyalty product.
#
# Environment variables hold credentials, certificates and infrastructure only.
# Everything about business behaviour — locations, geofence radiuses, campaigns,
# notification copy, automation rules — is configured by the merchant in the
# dashboard and stored in the database. Nothing in this file needs to change
# after deployment to alter how the product behaves for a merchant.
#
# Local development: copy to .env.local (or .env) and fill in the required block.
# Production: set these in Railway's variable editor. Never commit a filled copy.
# =============================================================================

# -- Required -----------------------------------------------------------------

# The application's own origin. Every generated URL is built from it: password
# reset and email confirmation links, customer card links, wallet pass web
# service callbacks, QR targets, canonical tags, Open Graph, the sitemap and
# outbound webhooks. Nothing in the codebase hardcodes a domain.
#
#   development         http://localhost:3000
#   future production   https://passimo.app
#
# passimo.app is NOT purchased or connected yet. Do not set it as the active URL
# until DNS and TLS exist — links generated with it would simply not resolve.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL. The only coupling to a database host anywhere in the product.
#
#   development   pnpm db:up, then the value below
#   production    the value Railway injects when a PostgreSQL service is attached
#                 (reference it as ${{Postgres.DATABASE_URL}})
#
# Port 5433 rather than 5432 in the sample because many machines already run a
# native PostgreSQL on the default port, and two servers on one port is how
# "password authentication failed" happens against a database whose password is
# definitely correct.
DATABASE_URL=postgresql://passimo:passimo@127.0.0.1:5433/passimo

# Signing key for wallet passes, unsubscribe links, survey links, customer card
# URLs and signed file downloads. Rotating it invalidates every outstanding link.
#   openssl rand -base64 48
APP_TOKEN_SECRET=

# Signing key for session cookies. Falls back to APP_TOKEN_SECRET when unset, so
# a small deployment can run on one secret; separate them in production so
# rotating link signatures does not sign every merchant out.
#   openssl rand -base64 48
AUTH_SESSION_SECRET=

# -- Database tuning (optional) ------------------------------------------------
# `disable` | `require` | `verify`. Unset infers from the host: off for
# localhost, on-without-CA-verification for anything else, which is what managed
# providers hand out certificates for.
DATABASE_SSL=
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_SLOW_QUERY_MS=500

# =============================================================================
# Object storage — merchant logos, campaign images, wallet assets, data exports
# =============================================================================
#
# `local` writes to disk. Correct in development, and correct in production
# *when the platform gives you a persistent volume* — Railway does, and this
# product's entire object corpus is a few hundred logos.
#
# `s3` targets any S3-compatible bucket (AWS, Cloudflare R2, Backblaze B2, MinIO,
# DigitalOcean Spaces) and is the right choice on an ephemeral filesystem or with
# more than one replica, where each container would otherwise hold a different
# subset of the files.
#
# See docs/INFRASTRUCTURE.md.

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.uploads

STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# Non-AWS providers, e.g. https://<account>.r2.cloudflarestorage.com
STORAGE_S3_ENDPOINT=
# CDN or custom domain for objects stored as public (logos, campaign images).
STORAGE_S3_PUBLIC_URL=

# -- Contact ------------------------------------------------------------------
# Where a human can reach a human. Both are unset by default, and the UI *hides*
# the contact link rather than rendering a `mailto:` that goes nowhere — a
# message the sender believes arrived is worse than no link at all. Set these
# once a mailbox exists on the production domain.
SUPPORT_EMAIL=
SALES_EMAIL=

# -- Scheduled jobs -----------------------------------------------------------
# Shared secret for /api/v1/jobs/run and /api/v1/cron/daily, and for the
# detailed form of /api/v1/health.
#   openssl rand -hex 32
CRON_SECRET=

# -- Email (Resend) -----------------------------------------------------------
# Without this, password reset and email confirmation links are logged in
# development and reported as undeliverable in production. Everything else works.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Passimo <hello@yourdomain.com>
RESEND_REPLY_TO=

# -- SMS (Twilio) -------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# -- WhatsApp (Meta Cloud API) ------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0

# -- Web push (VAPID) ---------------------------------------------------------
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@passimo.app

# =============================================================================
# Apple Wallet
# =============================================================================
#
# From developer.apple.com:
#   1. Create a Pass Type ID (Certificates, Identifiers & Profiles -> Identifiers)
#   2. Create a Pass Type ID certificate for it, export as .p12, convert to PEM
#   3. Download the Apple WWDR G4 intermediate certificate
#   4. Create an APNs Auth Key (.p8) for pass update pushes
#
# Certificates may be supplied EITHER inline as PEM (`*_PEM`, literal \n
# escapes are normalised) OR as a path to a mounted file (`*_PATH`). Inline
# suits Railway and any env-only platform; paths suit Docker and Kubernetes
# secret mounts. Set one.
#
# Absent, the product still issues Google passes and still works entirely from
# the customer's browser card. `/api/v1/wallet/apple/*` answers 503 with an
# actionable message rather than a stack trace.

APPLE_TEAM_ID=
APPLE_PASS_TYPE_IDENTIFIER=pass.app.passimo.loyalty

# Certificate paths (Docker / Kubernetes secret mounts)
APPLE_WWDR_CERTIFICATE_PATH=
APPLE_SIGNING_CERTIFICATE_PATH=
APPLE_SIGNING_PRIVATE_KEY_PATH=
APPLE_SIGNING_KEY_PASSWORD=

# Certificate values inline (Railway / Fly / any env-only platform)
APPLE_WWDR_CERT_PEM=
APPLE_SIGNER_CERT_PEM=
APPLE_SIGNER_KEY_PEM=

# Pass metadata. Organization name falls back to each merchant's own business
# name, which is almost always what you want; set this only for a white-label
# deployment that must show one issuer for every merchant.
APPLE_WALLET_ORGANIZATION_NAME=
# Defaults to $NEXT_PUBLIC_APP_URL/api/v1/wallet/apple. Override only when the
# pass web service is served through a different hostname or gateway. Getting
# this out of sync with the app URL is the single most common reason a pass
# installs and then never updates again.
APPLE_WALLET_WEB_SERVICE_URL=
# Fallback shared credential for the pass web service. Per-customer tokens are
# generated automatically; set this only if a gateway in front of the web
# service expects one fixed bearer token.
APPLE_WALLET_AUTH_TOKEN=

# APNs auth key for pushing pass updates (location relevance, balance changes)
APPLE_PUSH_KEY_P8=
APPLE_PUSH_KEY_PATH=
APPLE_PUSH_KEY_ID=
APNS_PRODUCTION=false

# Optional signature check on inbound wallet webhooks
APPLE_WALLET_WEBHOOK_SECRET=

# =============================================================================
# Google Wallet
# =============================================================================
#
# From the Google Wallet Console (pay.google.com/business/console) plus a Google
# Cloud service account holding the Wallet Object Issuer role.
#
# Supply EITHER the whole downloaded service-account JSON, OR the two fields
# from it that are actually used (email + private key).

GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_PROJECT_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
GOOGLE_WALLET_PRIVATE_KEY_PATH=
# Alternative to the two fields above: the raw JSON blob, on one line.
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=

# =============================================================================
# Google Maps platform — geocoding and place lookup for store locations
# =============================================================================
#
# Optional. Without them a merchant types latitude and longitude by hand and
# every proximity feature still works; with them, they type an address and we
# resolve it. GOOGLE_MAPS_API_KEY is the fallback for the other two, so a single
# key is enough for development.

GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_API_KEY=
GOOGLE_PLACES_API_KEY=

# Deployment-level kill switch for ALL geofence evaluation. Merchant-level
# toggles live in the dashboard (wallet_settings); this is for operators who need
# to stop location processing platform-wide during an incident.
GOOGLE_GEOFENCING_ENABLED=true

# -- AI (Anthropic) -----------------------------------------------------------
# Powers churn explanations, campaign drafting and reward suggestions. Absent,
# those screens say so explicitly rather than showing invented output.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# =============================================================================
# Billing (Stripe)
# =============================================================================
#
# Powers three things: our own subscription billing, the online gift card shop,
# and the merchant referral credit. Leave blank and all three are reported as
# "not configured" rather than failing — the loyalty product works without them.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# One Stripe price per purchasable plan and interval. The plan *shape* (limits,
# features, positioning) lives in lib/billing/plans.ts; only the price ids are
# deployment configuration, because they differ between test and live mode. A
# plan with no price id configured is shown on the billing screen but cannot be
# checked out.
#
# Prices: Starter $5/mo, Growth $19/mo, Pro $49/mo, Business $99/mo.
# There is no free plan. Yearly prices are ten months' worth — two months free.
#
# Webhook endpoint: POST /api/v1/billing/webhook
#   Events: checkout.session.completed, customer.subscription.*,
#           invoice.paid, invoice.payment_failed
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# =============================================================================
# Demo environment (local development only)
# =============================================================================
#
# `pnpm seed:demo` creates four merchant accounts — one per paid plan — a
# platform admin, and a full set of realistic data. It refuses to run when
# NEXT_PUBLIC_APP_URL does not look like a development host.

DEMO_PASSWORD=PassimoDemo2026!
# Comma-separated emails promoted to platform admin by the seed script.
PLATFORM_ADMIN_EMAILS=admin@passimo.demo

# -- Operational tuning -------------------------------------------------------
LOG_LEVEL=info
CAMPAIGN_BATCH_SIZE=200
WORKER_BATCH_SIZE=50
MAX_IMPORT_ROWS=20000
MAX_LOGO_BYTES=2097152

# -- Local PostgreSQL (docker-compose only) -----------------------------------
POSTGRES_DB=passimo
POSTGRES_USER=passimo
POSTGRES_PASSWORD=passimo
POSTGRES_PORT=5433
